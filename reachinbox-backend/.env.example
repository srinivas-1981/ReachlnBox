# ReachInbox Backend Environment Variables

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/reachinbox

# Redis Configuration (BullMQ & Rate Limiter)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Worker Configuration
WORKER_CONCURRENCY=5

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# SMTP Configuration (Nodemailer / Ethereal)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=ReachInbox <noreply@reachinbox.ai>
MITRAJIT_EMAIL=mitrajit@reachinbox.ai
MITRAJIT_PASSWORD=your_mitrajit_password_here
YADAV036_EMAIL=yadav036@reachinbox.ai
YADAV036_PASSWORD=your_yadav036_password_here

